# Copiez ce fichier en `.env` puis renseignez vos propres valeurs.
# cp .env.example .env

# Connexion PostgreSQL (Neon, Supabase, RDS, instance locale...).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/chauffeur_rapide?schema=public"

# Secret utilisé pour signer les cookies de session (JWT). Générez une valeur
# aléatoire forte, par exemple avec: openssl rand -base64 32
AUTH_SECRET="changez-moi-en-une-valeur-aleatoire-longue"

# Dossier de stockage local des documents uploadés (hors de /public).
STORAGE_DIR="./storage/uploads"

# --- WhatsApp (abstraction, non branchée en MVP — voir lib/whatsapp) ---
# Une fois l'intégration Meta Cloud API réelle branchée, renseigner :
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="changez-moi"
WHATSAPP_BUSINESS_NUMBER="2250000000000"

# --- Paiement (abstraction, non branchée en MVP — voir lib/billing) ---
BILLING_PROVIDER="mock"
